body {
  margin: 0;
  padding: 0;
  background-image: url('/fondo.png') !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  background-color: #090706;
  color: #eee8df;
  min-height: 100vh;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

#root {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  background: transparent !important;
}

/* =========================================================
   SHOP
   ========================================================= */

.container {
  width: 100%;
  margin: 0;
  padding: 2rem 2.5rem;
  box-sizing: border-box;
}

.content {
  width: 100%;
}

.wrapper {
  width: 100%;
}

/* =========================================================
   PRODUCTS SECTION
   ========================================================= */

#products {
  position: relative;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0 clamp(2rem, 5vw, 6rem) 5rem;
  box-sizing: border-box;
}

/* =========================================================
   SECTION TITLE
   ========================================================= */

.sectionTitle {
  position: relative;
  margin: 0 0 2rem;
  padding-bottom: 1rem;

  color: #f3ede5;
  font-size: clamp(1.5rem, 2vw, 2rem);
  font-weight: 800;
  letter-spacing: -0.02em;

  text-shadow:
    0 2px 10px rgba(0, 0, 0, 0.65);
}

.sectionTitle::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;

  width: 70px;
  height: 3px;

  background: linear-gradient(
    90deg,
    #f49b38,
    #8a271e,
    transparent
  );

  border-radius: 999px;
}

/* =========================================================
   PRODUCT GRID / MUEBLE
   ========================================================= */

.cardsGrid {
  position: relative;

  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 4rem clamp(2rem, 3vw, 4rem);

  width: 100%;

  padding: 5.5rem clamp(2rem, 3vw, 4rem) 3rem;

  box-sizing: border-box;
  align-items: start;

  /* Estructura principal */
  background:
    linear-gradient(
      180deg,
      rgba(19, 14, 11, 0.78),
      rgba(8, 7, 6, 0.45) 45%,
      rgba(8, 7, 6, 0.25)
    );

  border: 1px solid rgba(200, 155, 60, 0.20);

  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.48),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 70px rgba(0, 0, 0, 0.28);
}

/* =========================================================
   VIGA SUPERIOR
   ========================================================= */

.cardsGrid::before {
  content: "";

  position: absolute;

  top: 1.2rem;
  left: 1.5rem;
  right: 1.5rem;

  height: 12px;

  background:
    linear-gradient(
      180deg,
      #3a2a1c,
      #17110d 45%,
      #090706
    );

  border-top: 1px solid rgba(218, 174, 91, 0.65);
  border-bottom: 1px solid rgba(218, 174, 91, 0.22);

  box-shadow:
    0 5px 14px rgba(0, 0, 0, 0.65),
    0 0 20px rgba(200, 155, 60, 0.08);

  z-index: 0;
}

/* Detalle dorado central de la viga */

.cardsGrid::after {
  content: "";

  position: absolute;

  top: 1.2rem;
  left: 50%;

  width: 180px;
  height: 12px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(200, 155, 60, 0.75),
      transparent
    );

  opacity: 0.7;

  pointer-events: none;

  z-index: 1;
}

/* =========================================================
   SOPORTES DE LAS TARJETAS
   ========================================================= */

/*
   IMPORTANTE:
   ProductCard utiliza .productCard, no .card.
*/

.cardsGrid > .productCard {
  position: relative;
  z-index: 2;
}

/* Cable central */

.cardsGrid > .productCard .cardSuspension {
  position: absolute;

  top: -4.3rem;
  left: 50%;

  width: 2px;
  height: 4.3rem;

  transform: translateX(-50%);

  background:
    linear-gradient(
      180deg,
      rgba(218, 174, 91, 0.95),
      rgba(200, 155, 60, 0.55),
      rgba(200, 155, 60, 0.15)
    );

  box-shadow:
    0 0 7px rgba(200, 155, 60, 0.25);

  z-index: 3;
}

/* Pequeño enganche superior */

.cardsGrid > .productCard .cardSuspension::before {
  content: "";

  position: absolute;

  top: -2px;
  left: 50%;

  width: 9px;
  height: 9px;

  transform: translateX(-50%);

  border: 2px solid rgba(218, 174, 91, 0.85);
  border-radius: 50%;

  background: #17110d;

  box-shadow:
    0 0 8px rgba(200, 155, 60, 0.25);
}

/* =========================================================
   PRODUCT CARD
   ========================================================= */

.productCard {
  --rank-color: #f49b38;

  position: relative;

  display: flex;
  flex-direction: column;

  min-height: 390px;
  padding: 1.6rem;

  box-sizing: border-box;
  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(30, 24, 21, 0.92),
      rgba(12, 10, 9, 0.88)
    );

  border: 1px solid color-mix(
    in srgb,
    var(--rank-color) 30%,
    rgba(255, 255, 255, 0.08)
  );

  border-radius: 18px;

  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.productCard::before {
  content: "";

  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  height: 3px;

  background: linear-gradient(
    90deg,
    transparent,
    var(--rank-color),
    transparent
  );

  opacity: 0.85;
}

.productCard::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  top: -90px;
  right: -80px;

  background: var(--rank-color);
  opacity: 0.06;

  border-radius: 50%;
  filter: blur(35px);

  pointer-events: none;
}

.productCard:hover {
  transform: translateY(-7px);

  border-color: color-mix(
    in srgb,
    var(--rank-color) 65%,
    rgba(255, 255, 255, 0.1)
  );

  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.5),
    0 0 25px color-mix(
      in srgb,
      var(--rank-color) 15%,
      transparent
    );
}

/* =========================================================
   BADGE
   ========================================================= */

.cardBadge {
  align-self: flex-start;

  display: inline-flex;
  align-items: center;

  padding: 0.35rem 0.75rem;

  background: color-mix(
    in srgb,
    var(--rank-color) 12%,
    rgba(0, 0, 0, 0.35)
  );

  color: var(--rank-color);

  border: 1px solid color-mix(
    in srgb,
    var(--rank-color) 35%,
    transparent
  );

  border-radius: 999px;

  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* =========================================================
   STARS
   ========================================================= */

.cardStars {
  margin-top: 1rem;

  color: var(--rank-color);

  font-size: 1.05rem;
  letter-spacing: 0.18em;

  text-shadow:
    0 0 8px color-mix(
      in srgb,
      var(--rank-color) 45%,
      transparent
    );
}

/* =========================================================
   TITLE
   ========================================================= */

.cardTitle {
  margin: 0.75rem 0 0.35rem;

  color: #ffffff;

  font-size: 1.55rem;
  font-weight: 850;
  line-height: 1.15;

  letter-spacing: -0.025em;

  text-shadow:
    0 2px 8px rgba(0, 0, 0, 0.5);
}

/* =========================================================
   PRICE
   ========================================================= */

.cardPrice {
  margin-top: 0.3rem;

  color: var(--rank-color);

  font-size: 1.7rem;
  font-weight: 900;
  line-height: 1;

  text-shadow:
    0 0 16px color-mix(
      in srgb,
      var(--rank-color) 20%,
      transparent
    );
}

/* =========================================================
   DESCRIPTION
   ========================================================= */

.cardDescription {
  margin: 1rem 0 0;

  color: rgba(238, 232, 223, 0.72);

  font-size: 0.92rem;
  line-height: 1.6;

  min-height: 48px;
}

/* =========================================================
   DIVIDER
   ========================================================= */

.cardDivider {
  width: 100%;
  height: 1px;

  margin: 1.25rem 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.13),
      transparent
    );
}

/* =========================================================
   HIGHLIGHTS
   ========================================================= */

.cardHighlights {
  display: flex;
  flex-direction: column;

  gap: 0.55rem;

  margin: 0;
  padding: 0;

  list-style: none;
}

.cardHighlights li {
  position: relative;

  padding-left: 1.2rem;

  color: rgba(245, 239, 232, 0.82);

  font-size: 0.82rem;
  line-height: 1.4;
}

.cardHighlights li::before {
  content: "✓";

  position: absolute;

  left: 0;
  top: 0;

  color: var(--rank-color);

  font-weight: 900;
}

/* =========================================================
   BUTTON
   ========================================================= */

.btnAdd {
  position: relative;

  width: 100%;
  margin-top: auto;
  padding: 0.85rem 1rem;

  border: 1px solid color-mix(
    in srgb,
    var(--rank-color) 55%,
    rgba(255, 255, 255, 0.1)
  );

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      color-mix(
        in srgb,
        var(--rank-color) 22%,
        rgba(20, 15, 12, 0.9)
      ),
      rgba(20, 15, 12, 0.92)
    );

  color: #ffffff;

  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.02em;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.btnAdd:hover {
  transform: translateY(-2px);

  border-color: var(--rank-color);

  background:
    linear-gradient(
      135deg,
      color-mix(
        in srgb,
        var(--rank-color) 35%,
        rgba(20, 15, 12, 0.9)
      ),
      color-mix(
        in srgb,
        var(--rank-color) 12%,
        rgba(20, 15, 12, 0.95)
      )
    );

  box-shadow:
    0 8px 20px color-mix(
      in srgb,
      var(--rank-color) 18%,
      transparent
    );
}

.btnAdd:active {
  transform: translateY(0);
}

/* =========================================================
   GENERIC GLASS CARD
   ========================================================= */

.glassCard {
  background: rgba(22, 18, 16, 0.55);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;

  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.37);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1200px) {
  #products {
    padding-left: 3rem;
    padding-right: 3rem;
  }

  .cardsGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 4rem 2rem;

    padding-left: 2rem;
    padding-right: 2rem;
  }
}

@media (max-width: 900px) {
  #products {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .cardsGrid {
    gap: 3.5rem 1.5rem;

    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (max-width: 700px) {
  #products {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 3rem;
  }

  .cardsGrid {
    grid-template-columns: 1fr;

    gap: 3.5rem;

    padding: 5rem 1rem 2rem;
  }
}

@media (max-width: 450px) {
  #products {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .cardsGrid {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
}

/* =========================================================
   REDUCE MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .productCard,
  .btnAdd {
    transition: none;
  }

  .productCard:hover,
  .btnAdd:hover {
    transform: none;
  }
}
