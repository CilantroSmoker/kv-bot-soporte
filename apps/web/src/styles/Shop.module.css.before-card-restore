/* =========================================================
   SHOP GLOBAL
   ========================================================= */

body {
  margin: 0;
  padding: 0;

  background-image: url('/fondo.png') !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  background-color: #090706;

  color: #eee8df;

  min-height: 100vh;

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

#root {
  min-height: 100vh;
  width: 100%;
  max-width: none;

  margin: 0;
  padding: 0;

  display: flex;
  flex-direction: column;

  background: transparent !important;
}

/* =========================================================
   SHOP
   ========================================================= */

.container {
  width: 100%;
  max-width: none;

  margin: 0;
  padding: 2rem 3rem;

  box-sizing: border-box;
}

.content,
.wrapper {
  width: 100%;
}

/* =========================================================
   PRODUCTS SECTION
   ========================================================= */

#products {
  position: relative;

  width: 100%;
  max-width: none;

  margin: 0;

  padding: 0 4vw 5rem;

  box-sizing: border-box;
}

/* =========================================================
   SECTION TITLE
   ========================================================= */

.sectionTitle {
  position: relative;

  margin: 0 0 2rem;
  padding-bottom: 1rem;

  color: #f3ede5;

  font-size: clamp(1.5rem, 2vw, 2rem);
  font-weight: 800;

  letter-spacing: -0.02em;

  text-shadow:
    0 2px 10px rgba(0, 0, 0, 0.65);
}

.sectionTitle::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 70px;
  height: 3px;

  background:
    linear-gradient(
      90deg,
      #f49b38,
      #8a271e,
      transparent
    );

  border-radius: 999px;
}

/* =========================================================
   PRODUCT GRID / MUEBLE
   ========================================================= */

.cardsGrid {
  position: relative;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap:
    4rem
    clamp(1.25rem, 2.5vw, 2.5rem);

  width: 100%;

  /*
   * Este padding crea el espacio interno del mueble.
   * No es el margen exterior de la página.
   */
  padding:
    5.5rem
    clamp(1.25rem, 2.5vw, 2.5rem)
    3rem;

  box-sizing: border-box;

  align-items: start;

  background:
    linear-gradient(
      180deg,
      rgba(19, 14, 11, 0.78),
      rgba(8, 7, 6, 0.45) 45%,
      rgba(8, 7, 6, 0.25)
    );

  border: 1px solid rgba(200, 155, 60, 0.20);

  box-shadow:
    0 25px 70px rgba(0, 0, 0, 0.48),
    inset 0 1px 0 rgba(255, 255, 255, 0.035),
    inset 0 0 70px rgba(0, 0, 0, 0.28);
}

/* =========================================================
   VIGA SUPERIOR
   ========================================================= */

.cardsGrid::before {
  content: "";

  position: absolute;

  top: 1.2rem;
  left: 1.5rem;
  right: 1.5rem;

  height: 12px;

  background:
    linear-gradient(
      180deg,
      #3a2a1c,
      #17110d 45%,
      #090706
    );

  border-top: 1px solid rgba(218, 174, 91, 0.65);
  border-bottom: 1px solid rgba(218, 174, 91, 0.22);

  box-shadow:
    0 5px 14px rgba(0, 0, 0, 0.65),
    0 0 20px rgba(200, 155, 60, 0.08);

  z-index: 0;
}

/* =========================================================
   DETALLE CENTRAL DE LA VIGA
   ========================================================= */

.cardsGrid::after {
  content: "";

  position: absolute;

  top: 1.2rem;
  left: 50%;

  width: 180px;
  height: 12px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(200, 155, 60, 0.75),
      transparent
    );

  opacity: 0.7;

  pointer-events: none;

  z-index: 1;
}

/* =========================================================
   PRODUCT CARD WRAPPER
   ========================================================= */

.cardsGrid > .card {
  position: relative;
  z-index: 2;
}

/* =========================================================
   CABLE / CADENA
   ========================================================= */

.cardsGrid > .card::before {
  content: "";

  position: absolute;

  top: 0;
  left: 50%;

  width: 1px;
  height: 58px;

  transform: translateX(-50%);

  background:
    linear-gradient(
      180deg,
      rgba(200, 155, 60, 0.85),
      rgba(200, 155, 60, 0.35),
      transparent
    );

  box-shadow:
    0 0 7px rgba(200, 155, 60, 0.20);

  z-index: 1;
}

/* =========================================================
   GENERIC GLASS CARD
   ========================================================= */

.glassCard {
  background: rgba(22, 18, 16, 0.55);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  border: 1px solid rgba(255, 255, 255, 0.08);

  border-radius: 16px;

  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.37);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1150px) {
  #products {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .cardsGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 4rem 1.5rem;

    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
}

@media (max-width: 700px) {
  #products {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-bottom: 3rem;
  }

  .cardsGrid {
    grid-template-columns: 1fr;

    gap: 3rem;

    padding:
      5rem
      1rem
      2rem;
  }
}

@media (max-width: 450px) {
  #products {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .cardsGrid {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
}

/* =========================================================
   REDUCE MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .productCard,
  .btnAdd {
    transition: none;
  }

  .productCard:hover,
  .btnAdd:hover {
    transform: none;
  }
}

/* =========================================================
SHOP TABS
========================================================= */

.shopTabs {
  width: 100%;

  display: flex;
  justify-content: center;
  align-items: center;

  gap: 2.5rem;

  margin-top: 3.5rem;
  margin-bottom: 3.5rem;

  flex-wrap: wrap;
}

.shopTab {
  --tab-color: #c89b3c;

  position: relative;

  min-width: 150px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 0.65rem;

  padding: 1rem 1.6rem;

  background:
    linear-gradient(
      145deg,
      rgba(30, 22, 17, 0.97),
      rgba(12, 10, 8, 0.97)
    );

  color: rgba(238, 228, 210, 0.78);

  border: 1px solid color-mix(
    in srgb,
    var(--tab-color) 35%,
    rgba(255, 255, 255, 0.08)
  );

  border-radius: 14px;

  box-shadow:
    0 10px 28px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);

  font-size: 0.78rem;
  font-weight: 800;

  letter-spacing: 0.14em;
  text-transform: uppercase;

  cursor: pointer;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease,
    color 0.25s ease;
}


/* pequeño detalle ornamental */
.shopTab::before {
  content: "";

  position: absolute;

  top: 5px;
  left: 50%;

  width: 28px;
  height: 1px;

  transform: translateX(-50%);

  background: linear-gradient(
    90deg,
    transparent,
    rgba(200, 155, 60, 0.5),
    transparent
  );

  opacity: 0.65;
}

.shopTab svg {
  color: #c89b3c;

  transition:
    transform 0.25s ease,
    filter 0.25s ease;
}

/* HOVER */

.shopTab:hover {
  transform: translateY(-4px);

  color: #c89b3c;

  border-color: rgba(200, 155, 60, 0.65);

  background:
    linear-gradient(
      145deg,
      rgba(42, 31, 23, 0.98),
      rgba(15, 11, 9, 0.98)
    );

  box-shadow:
    0 12px 28px rgba(0, 0, 0, 0.42),
    0 0 18px rgba(200, 155, 60, 0.08);
}

.shopTab:hover svg {
  transform: scale(1.08);

  filter:
    drop-shadow(0 0 6px rgba(200, 155, 60, 0.35));
}

/* TAB ACTIVO */

.shopTabActive {
  color: #f5eee2;

  border-color: #c89b3c;

  background:
    linear-gradient(
      145deg,
      rgba(54, 37, 24, 0.98),
      rgba(18, 12, 9, 0.98)
    );

  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.45),
    0 0 20px rgba(200, 155, 60, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.shopTabActive::after {
  content: "";

  position: absolute;

  bottom: -6px;
  left: 50%;

  width: 34px;
  height: 2px;

  transform: translateX(-50%);

  background: linear-gradient(
    90deg,
    transparent,
    #c89b3c,
    transparent
  );

  box-shadow:
    0 0 8px rgba(200, 155, 60, 0.4);
}

.shopTabActive svg {
  color: #f49b38;

  filter:
    drop-shadow(0 0 6px rgba(244, 155, 56, 0.35));
}

/* =========================================================
RESPONSIVE TABS
========================================================= */

@media (max-width: 700px) {
  .shopTabs {
    gap: 1rem;

    margin-top: 3rem;
    margin-bottom: 2.5rem;
  }

  .shopTab {
    min-width: 140px;

    padding: 0.9rem 1.4rem;
  }
}

@media (max-width: 450px) {
  .shopTabs {
    gap: 0.8rem;
  }

  .shopTab {
    min-width: 125px;

    padding: 0.8rem 1rem;

    font-size: 0.72rem;
  }
}
